{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "C/C++: arm-none-eabi-g++ Aktive Datei kompilieren",
			"command": "/opt/arm-gnu-toolchain/bin/arm-none-eabi-g++",
			"args": [
				"-fdiagnostics-color=always",
				"-g",
				"${file}",
				"-o",
				"${fileDirname}/${fileBasenameNoExtension}"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "Compiler: /opt/arm-gnu-toolchain/bin/arm-none-eabi-g++"
		}
	]
}